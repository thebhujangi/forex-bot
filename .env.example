# Copy this file to ".env" (same folder) and fill in your values.
# .env is private: it is excluded from sharing and never printed by the bot.

# From @BotFather after /newbot (looks like 1234567890:AAH...)
TELEGRAM_BOT_TOKEN=

# Your personal chat id. Leave empty: scripts\telegram_setup.py finds it for you.
TELEGRAM_CHAT_ID=
